int removeDuplicates(int* nums, int numsSize) {
    // If the array has 2 or fewer elements, every element can stay
    if (numsSize <= 2) {
        return numsSize;
    }

    // 'k' tracks the index where the next valid element should be written.
    // The first two elements are always allowed to stay.
    int k = 2;

    // Scan through the array starting from the third element (index 2)
    for (int i = 2; i < numsSize; i++) {
        // Check if the current element is different from the element 
        // that was placed two positions back at index (k - 2)
        if (nums[i] != nums[k - 2]) {
            nums[k] = nums[i]; // Write it to the valid zone
            k++;              // Advance the write counter
        }
    }

    return k;
}
