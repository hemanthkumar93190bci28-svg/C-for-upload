int removeElement(int* nums, int numsSize, int val) {
    // 'k' tracks the index where the next valid element should be placed
    int k = 0;

    // Scan through the array using 'i'
    for (int i = 0; i < numsSize; i++) {
        // If the current element is not the target value
        if (nums[i] != val) {
            nums[k] = nums[i]; // Move it to the valid zone at the front
            k++;              // Advance the valid element counter
        }
    }

    return k;
}
