int removeDuplicates(int* nums, int numsSize) {
    if (numsSize == 0) return 0;

    // 'k' keeps track of the index where the next unique element should be placed
    int k = 1; 

    // 'i' scans through the array starting from the second element
    for (int i = 1; i < numsSize; i++) {
        // If we find a new unique element
        if (nums[i] != nums[i - 1]) {
            nums[k] = nums[i]; // Move it to the front at position k
            k++;              // Advance the unique element counter
        }
    }

    return k;
}
