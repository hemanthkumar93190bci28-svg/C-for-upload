#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Global phone mapping array
const char* phone_map[] = {
    "",     // 0
    "",     // 1
    "abc",  // 2
    "def",  // 3
    "ghi",  // 4
    "jkl",  // 5
    "mno",  // 6
    "pqrs", // 7
    "tuv",  // 8
    "wxyz"  // 9
};

void backtrack(char* digits, int index, char* current_path, char** result, int* returnSize) {
    // Base Case: If the path length matches the digits length, add to results
    if (digits[index] == '\0') {
        result[*returnSize] = malloc((index + 1) * sizeof(char));
        strcpy(result[*returnSize], current_path);
        (*returnSize)++;
        return;
    }

    int digit = digits[index] - '0';
    const char* letters = phone_map[digit];

    // Loop through all letters mapped to the current digit
    for (int i = 0; letters[i] != '\0'; i++) {
        current_path[index] = letters[i]; // Choose
        current_path[index + 1] = '\0';   // Null-terminate safely
        backtrack(digits, index + 1, current_path, result, returnSize); // Recurse
    }
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 * The size of the array is returned as *returnSize.
 */
char** letterCombinations(char* digits, int* returnSize) {
    *returnSize = 0;
    int len = strlen(digits);
    if (len == 0) {
        return NULL;
    }

    // 1. Calculate total possible combinations to allocate memory
    int total_combinations = 1;
    for (int i = 0; i < len; i++) {
        int digit = digits[i] - '0';
        total_combinations *= strlen(phone_map[digit]);
    }

    // 2. Allocate memory for array of strings and tracking buffer
    char** result = malloc(total_combinations * sizeof(char*));
    char* current_path = malloc((len + 1) * sizeof(char));

    // 3. Kick off backtracking
    backtrack(digits, 0, current_path, result, returnSize);

    // Clean up temporary path buffer
    free(current_path);

    return result;
}
