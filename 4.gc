#include <string.h>

// Helper function to get the integer value of a Roman symbol
int romanValue(char c) {
    switch (c) {
        case 'I': return 1;
        case 'V': return 5;
        case 'X': return 10;
        case 'L': return 50;
        case 'C': return 100;
        case 'D': return 500;
        case 'M': return 1000;
        default: return 0;
    }
}

int romanToInt(char* s) {
    int total = 0;
    int n = strlen(s);
    
    for (int i = 0; i < n - 1; i++) {
        int current = romanValue(s[i]);
        int next = romanValue(s[i+1]);
        
        // If current value is less than the next value, subtract it
        if (current < next) {
            total -= current;
        } else {
            total += current;
        }
    }
    
    // Always add the value of the last character
    total += romanValue(s[n-1]);
    
    return total;
}
