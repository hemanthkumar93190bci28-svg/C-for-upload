#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

bool isValid(char* s) {
    int len = strlen(s);
    
    // Allocate memory for the stack (at most, it will store all characters)
    char* stack = (char*)malloc(len * sizeof(char));
    int top = -1;
    
    for (int i = 0; i < len; i++) {
        char ch = s[i];
        
        // Push open brackets onto the stack
        if (ch == '(' || ch == '{' || ch == '[') {
            stack[++top] = ch;
        } 
        // Process close brackets
        else {
            // If stack is empty when encountering a closing bracket, it's invalid
            if (top == -1) {
                free(stack);
                return false;
            }
            
            // Check if it matches the top of the stack
            char openBrack = stack[top];
            if ((ch == ')' && openBrack == '(') ||
                (ch == '}' && openBrack == '{') ||
                (ch == ']' && openBrack == '[')) {
                top--; // Valid match, pop it
            } else {
                free(stack);
                return false; // Mismatched brackets
            }
        }
    }
    
    // If top is -1, all brackets were successfully matched and popped
    bool result = (top == -1);
    free(stack);
    return result;
}
