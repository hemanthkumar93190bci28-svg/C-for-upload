#include <stdbool.h>
#include <string.h>

bool canConstruct(char* ransomNote, char* magazine) {
    // Get lengths of both strings
    int noteLen = strlen(ransomNote);
    int magLen = strlen(magazine);
    
    // If the note requires more letters than the magazine contains, it's impossible
    if (noteLen > magLen) {
        return false;
    }
    
    // Initialize a frequency array for the 26 lowercase English letters
    int charCounts[26] = {0};
    
    // Count the frequency of each letter in the magazine
    for (int i = 0; i < magLen; i++) {
        charCounts[magazine[i] - 'a']++;
    }
    
    // Subtract the frequency of each letter needed for the ransomNote
    for (int i = 0; i < noteLen; i++) {
        int index = ransomNote[i] - 'a';
        charCounts[index]--;
        
        // If the count drops below 0, the magazine lacks enough of this letter
        if (charCounts[index] < 0) {
            return false;
        }
    }
    
    return true;
}
