#include <stdbool.h>
#include <string.h>

bool isIsomorphic(char* s, char* t) {
    int len = strlen(s);
    
    // Explicitly define arrays of size 256 for all standard ASCII characters
    int mapS[256] = {0};
    int mapT[256] = {0};
    
    for (int i = 0; i < len; i++) {
        unsigned char c1 = s[i];
        unsigned char c2 = t[i];
        
        // If their last-seen positions don't match, the structural mapping fails
        if (mapS[c1] != mapT[c2]) {
            return false;
        }
        
        // Store the position (using i + 1 so that index 0 means "never seen")
        mapS[c1] = i + 1;
        mapT[c2] = i + 1;
    }
    
    return true;
}
