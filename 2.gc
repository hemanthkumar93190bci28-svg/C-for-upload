#include <string.h>

int lengthOfLongestSubstring(char* s) {
    int char_map[128];
    // Initialize all positions to -1
    memset(char_map, -1, sizeof(char_map));
    
    int left = 0;
    int max_length = 0;
    int n = strlen(s);
    
    for (int right = 0; right < n; right++) {
        unsigned char current_char = s[right];
        
        // If the character was seen inside the current window
        if (char_map[current_char] >= left) {
            left = char_map[current_char] + 1;
        }
        
        // Record or update the index of the current character
        char_map[current_char] = right;
        
        // Calculate window size and update max_length
        int current_length = right - left + 1;
        if (current_length > max_length) {
            max_length = current_length;
        }
    }
    
    return max_length;
}
