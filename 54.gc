#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Helper function to find the maximum subsequence of a given size k from a single array
void maxSubarray(int* nums, int numsSize, int k, int* out) {
    int top = 0;
    for (int i = 0; i < numsSize; i++) {
        // Pop from stack if current element is larger and we still have enough elements left to reach k
        while (top > 0 && out[top - 1] < nums[i] && (top + numsSize - i) > k) {
            top--;
        }
        if (top < k) {
            out[top++] = nums[i];
        }
    }
}

// Helper function to lexicographically compare two array suffixes
int compare(int* arr1, int size1, int idx1, int* arr2, int size2, int idx2) {
    while (idx1 < size1 && idx2 < size2) {
        if (arr1[idx1] != arr2[idx2]) {
            return arr1[idx1] - arr2[idx2];
        }
        idx1++;
        idx2++;
    }
    return (size1 - idx1) - (size2 - idx2);
}

// Helper function to merge two subsequences optimally
void merge(int* sub1, int size1, int* sub2, int size2, int* res) {
    int idx1 = 0, idx2 = 0, r = 0;
    while (idx1 < size1 || idx2 < size2) {
        // Compare suffixes to greedily decide which element to pick next
        if (compare(sub1, size1, idx1, sub2, size2, idx2) > 0) {
            res[r++] = sub1[idx1++];
        } else {
            res[r++] = sub2[idx2++];
        }
    }
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* maxNumber(int* nums1, int nums1Size, int* nums2, int nums2Size, int k, int* returnSize) {
    *returnSize = k;
    int* best = (int*)calloc(k, sizeof(int));
    
    // Allocate temporary workspace buffers
    int* sub1 = (int*)malloc(k * sizeof(int));
    int* sub2 = (int*)malloc(k * sizeof(int));
    int* candidate = (int*)malloc(k * sizeof(int));
    
    // Determine the boundary limits for how many elements we can draw from nums1
    int start = (k - nums2Size > 0) ? k - nums2Size : 0;
    int end = (k < nums1Size) ? k : nums1Size;
    
    // Evaluate all combinations of picking 'i' items from nums1 and 'k-i' from nums2
    for (int i = start; i <= end; i++) {
        maxSubarray(nums1, nums1Size, i, sub1);
        maxSubarray(nums2, nums2Size, k - i, sub2);
        merge(sub1, i, sub2, k - i, candidate);
        
        // If the new candidate is lexicographically larger than our best choice, update it
        if (compare(candidate, k, 0, best, k, 0) > 0) {
            memcpy(best, candidate, k * sizeof(int));
        }
    }
    
    // Free temporary allocations
    free(sub1);
    free(sub2);
    free(candidate);
    
    return best;
}
