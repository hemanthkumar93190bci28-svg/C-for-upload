#include <stdio.h>
#include <stdlib.h>

// Comparison function for qsort
int compareInts(const void* a, const void* b) {
    long long arg1 = *(const long long*)a;
    long long arg2 = *(const long long*)b;
    if (arg1 < arg2) return -1;
    if (arg1 > arg2) return 1;
    return 0;
}

int numberOfBoomerangs(int** points, int pointsSize, int* pointsColSize) {
    int totalBoomerangs = 0;
    
    // Allocate space for distances from the current point to all other points
    long long* distances = (long long*)malloc(pointsSize * sizeof(long long));

    for (int i = 0; i < pointsSize; i++) {
        for (int j = 0; j < pointsSize; j++) {
            long long dx = points[i][0] - points[j][0];
            long long dy = points[i][1] - points[j][1];
            // Use squared distance to avoid floating-point precision issues
            distances[j] = dx * dx + dy * dy;
        }

        // Sort the distances to easily group identical values
        qsort(distances, pointsSize, sizeof(long long), compareInts);

        // Count consecutive identical distances
        int count = 1;
        for (int j = 1; j < pointsSize; j++) {
            if (distances[j] == distances[j - 1]) {
                count++;
            } else {
                if (count > 1) {
                    totalBoomerangs += count * (count - 1);
                }
                count = 1; // Reset for the next distance group
            }
        }
        // Handle the last group in the array
        if (count > 1) {
            totalBoomerangs += count * (count - 1);
        }
    }

    free(distances);
    return totalBoomerangs;
}
