#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* majorityElement(int* nums, int numsSize, int* returnSize) {
    // Stage 1: Find potential candidates
    int candidate1 = 0, candidate2 = 0;
    int count1 = 0, count2 = 0;
    
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] == candidate1) {
            count1++;
        } else if (nums[i] == candidate2) {
            count2++;
        } else if (count1 == 0) {
            candidate1 = nums[i];
            count1 = 1;
        } else if (count2 == 0) {
            candidate2 = nums[i];
            count2 = 1;
        } else {
            count1--;
            count2--;
        }
    }
    
    // Stage 2: Verify the candidates by counting their actual occurrences
    count1 = 0;
    count2 = 0;
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] == candidate1) {
            count1++;
        } else if (nums[i] == candidate2) {
            count2++;
        }
    }
    
    // Allocate space for the results (maximum 2 elements)
    int* result = (int*)malloc(2 * sizeof(int));
    int size = 0;
    
    int threshold = numsSize / 3;
    if (count1 > threshold) {
        result[size++] = candidate1;
    }
    // Make sure we don't accidentally count the same candidate twice if uninitialized counts overlapped
    if (count2 > threshold && candidate1 != candidate2) {
        result[size++] = candidate2;
    }
    
    *returnSize = size;
    return result;
}
