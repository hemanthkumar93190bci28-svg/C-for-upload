#include <string.h>
#include <stdlib.h>

// Helper function to expand outward from a given center and return the length
int expandAroundCenter(char* s, int left, int right, int len) {
    while (left >= 0 && right < len && s[left] == s[right]) {
        left--;
        right++;
    }
    // Return the length of the valid palindrome found
    return right - left - 1;
}

char* longestPalindrome(char* s) {
    if (s == NULL || *s == '\0') {
        return "";
    }
    
    int len = strlen(s);
    int start = 0;
    int max_len = 1; // Any single character is a palindrome of length 1
    
    for (int i = 0; i < len; i++) {
        // Case 1: Odd length palindromes (e.g., "aba", center is s[i])
        int len1 = expandAroundCenter(s, i, i, len);
        
        // Case 2: Even length palindromes (e.g., "abba", center is between s[i] and s[i+1])
        int len2 = expandAroundCenter(s, i, i + 1, len);
        
        // Find the maximum length between both configurations
        int current_max = (len1 > len2) ? len1 : len2;
        
        // Update global boundaries if a longer palindrome is found
        if (current_max > max_len) {
            max_len = current_max;
            // Calculate starting index based on the configuration length
            start = i - (current_max - 1) / 2;
        }
    }
    
    // Allocate memory for the substring + 1 extra byte for the null terminator '\0'
    char* result = (char*)malloc((max_len + 1) * sizeof(char));
    
    // Copy the specific window into the result string
    strncpy(result, s + start, max_len);
    result[max_len] = '\0'; // Explicitly add the null terminator
    
    return result;
}
