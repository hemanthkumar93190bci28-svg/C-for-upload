#include <stdbool.h>
#include <stdlib.h>

typedef struct Node {
    int val;
    struct Node* next;
} Node;

bool containsDuplicate(int* nums, int numsSize) {
    if (numsSize <= 1) return false;
    
    int tableSize = 20011; // A prime number size for the hash table
    Node** hashTable = (Node**)calloc(tableSize, sizeof(Node*));
    bool foundDuplicate = false;
    
    for (int i = 0; i < numsSize; i++) {
        int hashIdx = nums[i] % tableSize;
        if (hashIdx < 0) hashIdx += tableSize;
        
        // Search the bucket chain
        Node* curr = hashTable[hashIdx];
        while (curr != NULL) {
            if (curr->val == nums[i]) {
                foundDuplicate = true;
                break;
            }
            curr = curr->next;
        }
        
        if (foundDuplicate) break;
        
        // Insert new element into bucket
        Node* newNode = (Node*)malloc(sizeof(Node));
        newNode->val = nums[i];
        newNode->next = hashTable[hashIdx];
        hashTable[hashIdx] = newNode;
    }
    
    // Cleanup memory
    for (int i = 0; i < tableSize; i++) {
        Node* curr = hashTable[i];
        while (curr != NULL) {
            Node* tmp = curr;
            curr = curr->next;
            free(tmp);
        }
    }
    free(hashTable);
    
    return foundDuplicate;
}
