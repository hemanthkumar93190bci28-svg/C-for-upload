#include <stdbool.h>

bool isValidSudoku(char** board, int boardSize, int* boardColSize) {
    // 9x9 boolean grids to keep track of seen digits (1-9 mapped to indices 0-8)
    bool rows[9][9] = {false};
    bool cols[9][9] = {false};
    bool boxes[9][9] = {false};

    for (int i = 0; i < 9; i++) {
        for (int j = 0; j < 9; j++) {
            char val = board[i][j];
            
            // Skip empty cells
            if (val == '.') {
                continue;
            }
            
            // Convert character digit '1'-'9' to array index 0-8
            int numIdx = val - '1';
            
            // Map the row and column index to its respective 3x3 box index (0-8)
            int boxIdx = (i / 3) * 3 + (j / 3);
            
            // Check if the digit already exists in this row, column, or sub-box
            if (rows[i][numIdx] || cols[j][numIdx] || boxes[boxIdx][numIdx]) {
                return false;
            }
            
            // Mark the digit as seen
            rows[i][numIdx] = true;
            cols[j][numIdx] = true;
            boxes[boxIdx][numIdx] = true;
        }
    }
    
    return true;
}
