#include <stdbool.h>

// Helper macro to find the maximum of two values
int max(int a, int b) {
    return (a > b) ? a : b;
}

// Helper macro to find the minimum of two values
int min(int a, int b) {
    return (a < b) ? a : b;
}

int maxArea(int* height, int heightSize) {
    int left = 0;
    int right = heightSize - 1;
    int maxWater = 0;
    
    while (left < right) {
        // Calculate the distance between pointers
        int width = right - left;
        
        // Compute current water capacity
        int currentWater = min(height[left], height[right]) * width;
        
        // Keep track of the highest capacity seen so far
        maxWater = max(maxWater, currentWater);
        
        // Move the pointer that points to the shorter bar
        if (height[left] < height[right]) {
            left++;
        } else {
            right--;
        }
    }
    
    return maxWater;
}
